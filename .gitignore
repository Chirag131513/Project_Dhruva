# Raw data. ~700MB, freely re-downloadable via scripts/fetch_data.py, and deliberately
# never committed. `data/` is the portable default; DHRUVA_DATA overrides it.
data/*.csv
data/*.zip
data/*.parquet
data/_openml_cache/

# Cached model scores. Regenerated by the block scripts; the JSONs in results/ are the
# committed artefacts, not these.
results/*.npy

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/
.env

# Tooling
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
